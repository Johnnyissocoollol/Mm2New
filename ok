local enabled = false
local SPEED = 16
local FLIP_OFFSET = 3.2
local TP_SPEED = 1.3

local renderConnection = nil
local tpwalkConnection = nil
local bv, gyro

local function stopTPWalk()
	if tpwalkConnection then
		tpwalkConnection:Disconnect()
		tpwalkConnection = nil
	end
end

local function startTPWalk(char, humanoid)
	stopTPWalk()
	tpwalkConnection = RunService.Heartbeat:Connect(function(delta)
		if not char or not humanoid or not humanoid.Parent then
			stopTPWalk()
			return
		end
		if humanoid.MoveDirection.Magnitude > 0 then
			char:TranslateBy(humanoid.MoveDirection * TP_SPEED * delta * 10)
		end
	end)
end

local function enableEffect(char)
	local root = char:FindFirstChild("HumanoidRootPart")
	local humanoid = char:FindFirstChild("Humanoid")
	if not root or not humanoid then return end

	humanoid.PlatformStand = true

	bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
	bv.Velocity = Vector3.zero
	bv.Parent = root

	gyro = Instance.new("BodyGyro")
	gyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
	gyro.P = 1e6
	gyro.D = 200
	gyro.Parent = root

	startTPWalk(char, humanoid)

	renderConnection = RunService.RenderStepped:Connect(function()
		if not root or not root.Parent then return end

		local cam = workspace.CurrentCamera
		local camCF = cam.CFrame
		local forward = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z).Unit
		local right   = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit

		local move = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + forward end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - forward end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - right   end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + right   end

		local rayParams = RaycastParams.new()
		rayParams.FilterDescendantsInstances = {char}
		rayParams.FilterType = Enum.RaycastFilterType.Exclude

		local result = workspace:Raycast(root.Position, Vector3.new(0, -20, 0), rayParams)
		local targetY = result and (result.Position.Y + FLIP_OFFSET) or root.Position.Y
		local yVel = (targetY - root.Position.Y) * 10

		bv.Velocity = (move.Magnitude > 0 and move.Unit * SPEED or Vector3.zero) + Vector3.new(0, yVel, 0)

		local facingDir = move.Magnitude > 0 and move.Unit or forward
		gyro.CFrame = CFrame.new(Vector3.zero, facingDir) * CFrame.Angles(math.rad(180), 0, 0)
	end)
end

local function disableEffect(char)
	if renderConnection then renderConnection:Disconnect() renderConnection = nil end
	stopTPWalk()
	if bv then bv:Destroy() bv = nil end
	if gyro then gyro:Destroy() gyro = nil end
	local humanoid = char and char:FindFirstChild("Humanoid")
	if humanoid then humanoid.PlatformStand = false end
end

toggleBtn.MouseButton1Click:Connect(function()
	enabled = not enabled
	local char = player.Character

	if enabled then
		toggleBtn.BackgroundColor3 = Color3.fromRGB(80, 180, 80)
		toggleKnob.Position = UDim2.new(1, -17, 0.5, -7)
		if char then enableEffect(char) end
	else
		toggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
		toggleKnob.Position = UDim2.new(0, 3, 0.5, -7)
		if char then disableEffect(char) end
	end
end)

player.CharacterAdded:Connect(function(char)
	if enabled then
		task.wait(1)
		enableEffect(char)
	end
end)
