end

-- Update dropdown
local function updateDropdownList(filter)
    for _, child in pairs(dropdownScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    if #allWeapons == 0 then
        local emptyLabel = Instance.new("TextLabel")
        emptyLabel.Size = UDim2.new(1, 0, 0, 30)
        emptyLabel.BackgroundTransparency = 1
        emptyLabel.Text = "Loading..."
        emptyLabel.TextColor3 = Color3.fromRGB(120, 120, 120)
        emptyLabel.TextSize = 9
        emptyLabel.Font = Enum.Font.Gotham
        emptyLabel.Parent = dropdownScroll
        return
    end
    
    local filteredWeapons = allWeapons
    if filter and filter ~= "" then
        filteredWeapons = {}
        for _, weapon in pairs(allWeapons) do
            if string.find(string.lower(weapon.name), string.lower(filter)) then
                table.insert(filteredWeapons, weapon)
            end
        end
    end
    
    if #filteredWeapons == 0 then
        local emptyLabel = Instance.new("TextLabel")
        emptyLabel.Size = UDim2.new(1, 0, 0, 30)
        emptyLabel.BackgroundTransparency = 1
        emptyLabel.Text = "No matches"
        emptyLabel.TextColor3 = Color3.fromRGB(120, 120, 120)
        emptyLabel.TextSize = 9
        emptyLabel.Font = Enum.Font.Gotham
        emptyLabel.Parent = dropdownScroll
    else
        for _, weapon in pairs(filteredWeapons) do
            local weaponBtn = Instance.new("TextButton")
            weaponBtn.Size = UDim2.new(1, -4, 0, 28)
            weaponBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
            weaponBtn.Text = weapon.name
            weaponBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
            weaponBtn.TextSize = 9
            weaponBtn.Font = Enum.Font.Gotham
            weaponBtn.TextXAlignment = Enum.TextXAlignment.Left
            weaponBtn.BorderSizePixel = 0
            weaponBtn.Parent = dropdownScroll
            
            local padding = Instance.new("UIPadding")
            padding.PaddingLeft = UDim.new(0, 6)
            padding.Parent = weaponBtn
            
            local btnCorner = Instance.new("UICorner")
            btnCorner.CornerRadius = UDim.new(0, 3)
            btnCorner.Parent = weaponBtn
            
            weaponBtn.MouseButton1Click:Connect(function()
                selectedWeapon = weapon.name
                selectedWeaponFrame = weapon.frame
                selectedLabel.Text = "Selected: " .. selectedWeapon
                dropdownFrame.Visible = false
                dropdownOpen = false
                searchBox.Text = ""
                updateStatus("Selected: " .. selectedWeapon)
            end)
        end
    end
    
    task.wait()
    dropdownScroll.CanvasSize = UDim2.new(0, 0, 0, dropdownLayout.AbsoluteContentSize.Y + 5)
end

