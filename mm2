-- Find the correct UI path
local function findUIPath()
    if LocalPlayer.PlayerGui.MainGUI.Game:FindFirstChild("Inventory") then
        UIPath = LocalPlayer.PlayerGui.MainGUI.Game.Inventory.Main
    else
        UIPath = LocalPlayer.PlayerGui.MainGUI.Lobby.Screens.Inventory.Main
    end
end

-- Get all weapons
local function getAllWeapons()
    local weapons = {}
    if not UIPath then findUIPath() end
    
    pcall(function()
        for i, v in pairs(UIPath.Weapons.Items.Container:GetChildren()) do
            for i, v in pairs(v.Container:GetChildren()) do
                if v.Name == "Christmas" or v.Name == "Halloween" then
                    for i, v in pairs(v.Container:GetChildren()) do
                        if v:IsA("Frame") and v.ItemName and v.ItemName.Label then
                            local weaponName = v.ItemName.Label.Text
                            if weaponName ~= "Default Knife" and weaponName ~= "Default Gun" and weaponName ~= "" then
                                table.insert(weapons, {name = weaponName, frame = v})
                            end
                        end
                    end
                else
                    if v:IsA("Frame") and v.ItemName and v.ItemName.Label then
                        local weaponName = v.ItemName.Label.Text
                        if weaponName ~= "Default Knife" and weaponName ~= "Default Gun" and weaponName ~= "" then
                            table.insert(weapons, {name = weaponName, frame = v})
                        end
                    end
                end
            end
        end
    end)
    
    return weapons
end

-- Dupe selected weapon
local function dupeSelectedWeapon()
    if not selectedWeaponFrame then return false end
    
    pcall(function()
        local amount = selectedWeaponFrame.Container.Amount.Text
        if amount == "" or amount == "None" then
            selectedWeaponFrame.Container.Amount.Text = "x" .. dupeAmount
        else
            local num = tonumber(amount:match("x(%d+)"))
            if num then
                selectedWeaponFrame.Container.Amount.Text = "x" .. tostring(num * dupeAmount)
            else
                selectedWeaponFrame.Container.Amount.Text = "x" .. dupeAmount
            end
        end
    end)
    
    return true
end

-- Dupe all weapons
local function dupeAllWeapons()
    pcall(function()
        for i, v in pairs(UIPath.Weapons.Items.Container:GetChildren()) do
            for i, v in pairs(v.Container:GetChildren()) do
                if v.Name == "Christmas" or v.Name == "Halloween" then
                    for i, v in pairs(v.Container:GetChildren()) do
                        if v:IsA("Frame") and v.ItemName and v.ItemName.Label then
                            if v.ItemName.Label.Text ~= "Default Knife" and v.ItemName.Label.Text ~= "Default Gun" then
                                local amount = v.Container.Amount.Text
                                if amount == "" or amount == "None" then
                                    v.Container.Amount.Text = "x" .. dupeAmount
                                else
                                    local num = tonumber(amount:match("x(%d+)"))
                                    if num then
                                        v.Container.Amount.Text = "x" .. tostring(num * dupeAmount)
                                    end
                                end
                            end
                        end
                    end
                else
                    if v:IsA("Frame") and v.ItemName and v.ItemName.Label then
                        if v.ItemName.Label.Text ~= "Default Knife" and v.ItemName.Label.Text ~= "Default Gun" then
                            local amount = v.Container.Amount.Text
                            if amount == "" or amount == "None" then
                                v.Container.Amount.Text = "x" .. dupeAmount
                            else
                                local num = tonumber(amount:match("x(%d+)"))
                                if num then
                                    v.Container.Amount.Text = "x" .. tostring(num * dupeAmount)
                                end
                            end
                        end
                    end
                end
            end
        end
        
        for i, v in pairs(UIPath.Pets.Items.Container.Current.Container:GetChildren()) do
            if v:IsA("Frame") then
                local amount = v.Container.Amount.Text
                if amount == "" or amount == "None" then
                    v.Container.Amount.Text = "x" .. dupeAmount
                else
                    local num = tonumber(amount:match("x(%d+)"))
                    if num then
                        v.Container.Amount.Text = "x" .. tostring(num * dupeAmount)
                    end
                end
            end
        end
    end)
    return true
end

